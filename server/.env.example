# Development ThingsBoard stack - environment template (NON-SECRET values only).
#
# Copy this file to server/.env yourself, or simply run
#   server/scripts/gen_dev_tls.sh
# which creates server/.env from this template and fills in the generated
# secrets (the PostgreSQL password). server/.env is git-ignored - never
# commit it, and never put real passwords or keys in this template.

# Pinned image tags (see the Definition of Done: reproducible deployment).
TB_IMAGE=thingsboard/tb-node:4.3.1.3
POSTGRES_IMAGE=postgres:18.6
CADDY_IMAGE=caddy:2.9.1

# LAN endpoint identity. Must match the router DNS record / /etc/hosts entry
# described in server/README.md (DHCP reservation section).
TB_DNS_NAME=home-assistance.local

# Published LAN ports.
TB_HTTPS_PORT=443
TB_MQTT_TLS_PORT=8883

# PostgreSQL database name and user (non-secret).
POSTGRES_DB=thingsboard
POSTGRES_USER=postgres

# PostgreSQL password - SECRET. Leave empty here; gen_dev_tls.sh generates a
# random value into server/.env on first setup.
POSTGRES_PASSWORD=
